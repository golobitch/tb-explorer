# Dracula — draculatheme.com
#
# Flags keep their meaning across every theme: pending is this palette's yellow,
# voided and closed its red, linked its purple, history its blue — the same vocabulary
# the macOS app uses. Delete the `on …` from `text` to keep your terminal's own
# background (and its transparency).

# base
text           = #f8f8f2 on #282a36

# chrome
border         = #44475a
border.focus   = #bd93f9
title          = #ffffff bold
title.scope    = #bd93f9
title.count    = #6272a4
label          = #6272a4
value          = #ffffff bold
key            = #bd93f9 bold
hint           = #6272a4
logo           = #bd93f9
badge          = #282a36 on #50fa7b bold

# table
table.header   = #bd93f9 bold
table.cursor   = #282a36 on #bd93f9 bold
table.stripe   = on #44475a
table.id       = #6272a4
table.number   = default

# state
good           = #50fa7b
warn           = #f1fa8c
bad            = #ff5555
busy           = #f1fa8c

# flags
flag.pending   = #f1fa8c
flag.posted    = #50fa7b
flag.voided    = #ff5555
flag.closed    = #ff5555
flag.linked    = #ff79c6
flag.history   = #8be9fd
flag.other     = #6272a4

# verdict
status.posted  = #50fa7b
status.voided  = #ff5555
status.expired = #6272a4
status.pending = #f1fa8c
status.unknown = #f1fa8c

# amounts
net.negative   = #ff5555
net.positive   = default
