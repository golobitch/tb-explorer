# Rendered by .github/workflows/bump-tap.yml from a published ui-v* release.
cask "tb-explorer" do
  version "{{VERSION}}"
  sha256 "{{SHA}}"

  url "https://github.com/golobitch/tb-explorer/releases/download/ui-v#{version}/TigerBeetle-Explorer-macos-universal.zip",
      verified: "github.com/golobitch/tb-explorer/"
  name "TigerBeetle Explorer"
  desc "Read-only macOS browser for TigerBeetle clusters"
  homepage "https://golobitch.github.io/tb-explorer/"

  livecheck do
    url "https://github.com/golobitch/tb-explorer/releases"
    # Matches ui-v* only. :github_latest would follow whichever component released most recently,
    # and a cli release would quietly become the app's "new version".
    regex(/ui[._-]v?(\d+(?:\.\d+)+)/i)
    strategy :page_match
  end

  depends_on macos: ">= :sequoia"

  app "TigerBeetle Explorer.app"

  # The app is sandboxed, so its state lives in a container rather than loose in ~/Library.
  zap trash: [
    "~/Library/Containers/com.golobitch.tb-explorer",
    "~/Library/Application Support/tb-explorer",
    "~/Library/Preferences/com.golobitch.tb-explorer.plist",
    "~/Library/Saved Application State/com.golobitch.tb-explorer.savedState",
  ]
end
